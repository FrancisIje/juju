{
  "name": "@juju/core",
  "license": "MIT",
  "version": "0.1.0",
  "description": "Platform-independent core of the juju JavaScript SDKs: events, queue, batching, retry.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2020 --outfile=dist/index.js && tsc -p tsconfig.build.json"
  }
}
